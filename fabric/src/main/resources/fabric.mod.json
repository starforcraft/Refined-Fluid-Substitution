{
  "schemaVersion": 1,
  "id": "refinedfluidsubstitution",
  "version": "${version}",
  "name": "Refined Fluid Substitution",
  "description": "Adds a fluid substitution pattern, allowing fluids to be used directly instead of buckets to Refined Storage.",
  "authors": [
    "Ultramega"
  ],
  "contact": {
    "sources": "https://github.com/starforcraft/Refined-Fluid-Substitution",
    "issues": "https://github.com/starforcraft/Refined-Fluid-Substitution/issues"
  },
  "icon": "logo.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ultramega.refinedfluidsubstitution.fabric.ModInitializerImpl"
    ],
    "client": [
      "com.ultramega.refinedfluidsubstitution.fabric.ClientModInitializerImpl"
    ],
    "refinedstorage_plugin": [
      "com.ultramega.refinedfluidsubstitution.fabric.ModInitializerImpl"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/WpUmcmUayN"
      },
      "parent": "refinedstorage"
    }
  },
  "depends": {
    "fabricloader": ">=0.14.6",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "refinedstorage": ">=2.0.9",
    "java": ">=21",
    "cloth-config2": "*",
    "team_reborn_energy": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": [
    "refinedfluidsubstitution.mixins.json"
  ]
}
